{
  "profile": "release",
  "schemaVersion": "1.0.0",
  "contractVersion": "1.0.0",
  "minimumPavedaVersion": "0.1.0",
  "description": "Release profile for production handoff. Execution is supported, but release gates must be satisfied with direct evidence.",
  "extends": "strict",
  "scoreThresholds": [
    {
      "metric": "ambiguity_score",
      "pass": 0.05,
      "warn": 0.03,
      "block": 0.1,
      "repairTrigger": 0.05,
      "overrideAllowed": false
    },
    {
      "metric": "plan_quality_score",
      "pass": 0.97,
      "warn": 0.99,
      "block": 0.9,
      "repairTrigger": 0.96,
      "overrideAllowed": false
    },
    {
      "metric": "progress_score",
      "pass": 0.95,
      "warn": 0.98,
      "block": 0.9,
      "repairTrigger": 0.94,
      "overrideAllowed": false
    },
    {
      "metric": "match_score",
      "pass": 0.99,
      "warn": 1,
      "block": 0.95,
      "repairTrigger": 0.98,
      "overrideAllowed": false
    },
    {
      "metric": "verification_score",
      "pass": 1,
      "warn": 1,
      "block": 0.999,
      "repairTrigger": 1,
      "overrideAllowed": false
    },
    {
      "metric": "risk_score",
      "pass": 0.1,
      "warn": 0.05,
      "block": 0.2,
      "repairTrigger": 0.1,
      "overrideAllowed": false
    }
  ],
  "requiredGates": [
