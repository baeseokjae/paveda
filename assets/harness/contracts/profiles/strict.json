{
  "profile": "strict",
  "schemaVersion": "1.0.0",
  "contractVersion": "1.0.0",
  "minimumPavedaVersion": "0.1.0",
  "description": "Default /do profile. Code-changing tasks must produce unit and e2e gate evidence or block.",
  "extends": "standard",
  "scoreThresholds": [
    {
      "metric": "ambiguity_score",
      "pass": 0.15,
      "warn": 0.1,
      "block": 0.2,
      "repairTrigger": 0.15,
      "overrideAllowed": false
    },
    {
      "metric": "plan_quality_score",
      "pass": 0.9,
      "warn": 0.95,
      "block": 0.8,
      "repairTrigger": 0.88,
      "overrideAllowed": false
    },
    {
      "metric": "progress_score",
      "pass": 0.9,
      "warn": 0.95,
      "block": 0.75,
      "repairTrigger": 0.88,
      "overrideAllowed": false
    },
    {
      "metric": "match_score",
      "pass": 0.95,
      "warn": 0.98,
      "block": 0.85,
      "repairTrigger": 0.93,
      "overrideAllowed": false
    },
    {
      "metric": "verification_score",
      "pass": 1,
      "warn": 1,
      "block": 0.99,
      "repairTrigger": 1,
      "overrideAllowed": false
    },
    {
      "metric": "risk_score",
      "pass": 0.2,
      "warn": 0.12,
      "block": 0.3,
      "repairTrigger": 0.2,
      "overrideAllowed": false
    }
  ],
  "requiredGates": [
    {
      "id": "unit-gate",
      "phase": "unit-test",
      "evidenceKind": "unit_test",
      "requiredForTaskTypes": [
        "code",
        "ui",
        "api",
        "data",
        "infra",
        "test",
        "docs",
        "metadata",
        "mixed"
      ],
      "conditionalWhen": "task changes executable behavior",
      "capability": "test.unit",
      "missingCapabilityBehavior": "ask_setup_sprint",
      "notApplicablePolicy": {
        "allowed": true,
        "requiresRationale": true,
        "requiresClassifierReason": true,
        "requiresUserApproval": true
      },
      "failureBehavior": "repair_then_block",
      "repairAllowed": true,
      "releaseOverrideAllowed": false
    },
    {
      "id": "e2e-gate",
      "phase": "e2e-test",
      "evidenceKind": "e2e_test",
      "requiredForTaskTypes": [
        "code",
        "ui",
        "api",
        "data",
        "infra",
        "test",
        "docs",
        "metadata",
        "mixed"
      ],
      "conditionalWhen": "task changes user-visible behavior or system boundary behavior",
      "capability": "test.e2e",
      "missingCapabilityBehavior": "ask_setup_sprint",
      "notApplicablePolicy": {
        "allowed": true,
        "requiresRationale": true,
        "requiresClassifierReason": true,
        "requiresUserApproval": true
      },
      "failureBehavior": "repair_then_block",
      "repairAllowed": true,
      "releaseOverrideAllowed": false
    },
    {
      "id": "coverage-gate",
      "phase": "unit-test",
      "evidenceKind": "coverage",
      "requiredForTaskTypes": [
        "code",
        "ui",
        "api",
        "data",
        "infra",
        "test",
        "mixed"
      ],
      "conditionalWhen": "project policy declares coverage threshold",
      "capability": "test.coverage",
      "missingCapabilityBehavior": "block",
      "notApplicablePolicy": {
        "allowed": true,
        "requiresRationale": true,
        "requiresClassifierReason": true,
        "requiresUserApproval": true
      },
      "failureBehavior": "block",
      "repairAllowed": false,
      "releaseOverrideAllowed": false
    },
    {
      "id": "typecheck-gate",
      "phase": "unit-test",
      "evidenceKind": "typecheck",
      "requiredForTaskTypes": [
        "code",
        "ui",
        "api",
        "data",
        "infra",
        "test",
        "mixed"
      ],
      "conditionalWhen": "project has a typecheck command",
      "capability": "command.run",
      "missingCapabilityBehavior": "block",
      "notApplicablePolicy": {
        "allowed": false,
        "requiresRationale": true,
        "requiresClassifierReason": true,
        "requiresUserApproval": true
      },
      "failureBehavior": "repair_then_block",
      "repairAllowed": true,
      "releaseOverrideAllowed": false
    },
    {
      "id": "lint-gate",
      "phase": "unit-test",
      "evidenceKind": "lint",
      "requiredForTaskTypes": [
        "code",
        "ui",
        "api",
        "data",
        "infra",
        "test",
        "mixed"
      ],
      "conditionalWhen": "project has a lint command",
      "capability": "command.run",
      "missingCapabilityBehavior": "block",
      "notApplicablePolicy": {
        "allowed": false,
        "requiresRationale": true,
        "requiresClassifierReason": true,
        "requiresUserApproval": true
      },
      "failureBehavior": "repair_then_block",
      "repairAllowed": true,
      "releaseOverrideAllowed": false
    },
    {
      "id": "build-gate",
      "phase": "unit-test",
      "evidenceKind": "build",
      "requiredForTaskTypes": [
        "code",
        "ui",
        "api",
        "data",
        "infra",
        "test",
        "mixed"
      ],
      "conditionalWhen": "project has a build command",
      "capability": "command.run",
      "missingCapabilityBehavior": "block",
      "notApplicablePolicy": {
        "allowed": false,
        "requiresRationale": true,
        "requiresClassifierReason": true,
        "requiresUserApproval": true
      },
      "failureBehavior": "repair_then_block",
      "repairAllowed": true,
      "releaseOverrideAllowed": false
    },
    {
      "id": "semantic-gate",
      "phase": "semantic-adversarial-verification",
      "evidenceKind": "semantic_review",
      "requiredForTaskTypes": [
        "code",
        "ui",
        "api",
        "data",
        "infra",
        "test",
        "docs",
        "metadata",
        "mixed"
      ],
      "conditionalWhen": "strict profile is active",
      "capability": "semantic.review",
      "missingCapabilityBehavior": "block",
      "notApplicablePolicy": {
        "allowed": false,
        "requiresRationale": true,
        "requiresClassifierReason": true,
        "requiresUserApproval": true
      },
      "failureBehavior": "repair_then_block",
      "repairAllowed": true,
      "releaseOverrideAllowed": false
    },
    {
      "id": "risk-gate",
      "phase": "semantic-adversarial-verification",
      "evidenceKind": "risk_review",
      "requiredForTaskTypes": [
        "code",
        "ui",
        "api",
        "data",
        "infra",
        "test",
        "docs",
        "metadata",
        "mixed"
      ],
      "conditionalWhen": "strict profile is active",
      "capability": "risk.review",
      "missingCapabilityBehavior": "block",
      "notApplicablePolicy": {
        "allowed": false,
        "requiresRationale": true,
        "requiresClassifierReason": true,
        "requiresUserApproval": true
      },
      "failureBehavior": "repair_then_block",
      "repairAllowed": true,
      "releaseOverrideAllowed": false
    }
  ],
  "verificationLadder": [
    "command",
    "unit_test",
    "e2e_test",
    "semantic_review",
    "adversarial_review",
    "risk_review",
    "security_scan",
    "manual_decision",
    "host_event",
    "typecheck",
    "lint",
    "build",
    "coverage"
  ],
  "overridePolicy": {
    "allowedModes": [
      "approve-override",
      "import",
      "regenerate"
    ],
    "auditRequired": true,
    "releaseForbidden": [
      "unit-gate",
      "e2e-gate",
      "coverage-gate",
      "semantic-gate",
      "risk-gate"
    ],
    "expiryRequired": true
  },
  "notApplicablePolicy": {
    "allowedTaskTypes": [
      "docs",
      "metadata"
    ],
    "requiresRationale": true,
    "requiresClassifierReason": true,
    "ambiguousBehavior": "ask_user"
  },
  "releaseSupport": {
    "status": "supported",
    "suggestedProfile": "strict",
    "unimplementedGates": []
  }
}
