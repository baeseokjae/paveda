  "projectionRules": {
    "sourceRoots": [
      ".paveda/"
    ],
    "packageAssetRoots": [
      "assets/harness/contracts/",
      "assets/harness/hosts/"
    ],
    "generatedProjectionTargets": [
      ".claude/",
      ".codex/",
      ".pi/",
      ".hermes/",
      "AGENTS.md",
      "CLAUDE.md"
    ],
    "driftPolicy": "block",
    "allowedDriftResolutions": [
      "import",
      "regenerate",
      "approve-override"
    ]
  },
  "overridePolicy": {
    "allowedModes": [
      "approve-override",
      "import",
      "regenerate"
    ],
    "auditRequired": true,
    "releaseForbidden": [
      "unit-gate",
      "e2e-gate",
      "coverage-gate",
      "semantic-gate",
      "risk-gate",
      "adversarial-gate",
      "security-gate",
      "release-signoff",
      "full-conformance",
      "immutable-artifact-retention"
    ],
    "expiryRequired": true
  },
  "learningPolicy": {
    "states": [
      "observed",
      "candidate",
      "validated",
      "promoted",
      "retired"
    ],
    "promotion": {
      "minimumSuccessfulRuns": 3,
      "minimumConfidence": 0.9,
      "requiresUserApproval": true,
      "requiresEvidenceAudit": true
    },
    "restrictions": {
      "cannotRelaxGates": true,
      "cannotRelaxThresholds": true,
      "cannotBypassReleaseRestrictions": true
    }
  }
}
