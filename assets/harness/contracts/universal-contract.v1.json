  "scoreMetrics": [
    {
      "id": "ambiguity_score",
      "direction": "lower_is_better",
      "range": {
        "min": 0,
        "max": 1
      },
      "description": "Unresolved task and acceptance uncertainty.",
      "inputs": [
        "runs.objective",
        "runs.acceptance_criteria",
        "phase_events.clarification"
      ],
      "calculation": {
        "kind": "manual_review"
      },
