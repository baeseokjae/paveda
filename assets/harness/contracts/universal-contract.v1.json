      "calculation": {
        "kind": "weighted_inputs",
        "weights": {
          "phase_events": 0.4,
          "changes": 0.6
        }
      },
      "requiredEvidence": [
        "execution-command"
      ],
      "ledgerField": "scores.progress_score"
    },
    {
      "id": "match_score",
      "direction": "higher_is_better",
      "range": {
        "min": 0,
        "max": 1
      },
      "description": "Fit between implementation, contract, and acceptance criteria.",
      "inputs": [
        "runs.acceptance_criteria",
        "changes",
        "semantic-review"
      ],
      "calculation": {
        "kind": "manual_review"
      },
      "requiredEvidence": [
        "semantic-review"
      ],
      "ledgerField": "scores.match_score"
    },
    {
      "id": "verification_score",
      "direction": "higher_is_better",
      "range": {
        "min": 0,
        "max": 1
      },
      "description": "Coverage and directness of required verification evidence.",
      "inputs": [
        "unit-test-result",
        "e2e-test-result",
        "evidence-audit"
      ],
      "calculation": {
        "kind": "evidence_ratio"
      },
      "requiredEvidence": [
        "unit-test-result",
        "e2e-test-result",
        "evidence-audit"
      ],
      "ledgerField": "scores.verification_score"
    },
    {
      "id": "risk_score",
      "direction": "lower_is_better",
      "range": {
        "min": 0,
        "max": 1
      },
      "description": "Residual regression, safety, security, and policy risk.",
      "inputs": [
        "adversarial-review",
        "security-review",
        "policy_violations"
      ],
      "calculation": {
        "kind": "risk_rule"
      },
      "requiredEvidence": [
        "adversarial-review",
        "security-review"
      ],
      "ledgerField": "scores.risk_score"
    }
  ],
