[
	{
		"eval_id": 1,
		"eval_name": "commit-dry-run",
		"prompt": "--dry-run",
		"assertions": [
			{
				"text": "Conventional Commit 형식의 메시지가 출력되어야 함",
				"type": "match_format",
				"pattern": "(feat|fix|refactor|docs|test|chore)"
			},
			{
				"text": "Co-Authored-By가 포함되지 않아야 함",
				"type": "no_agent_call",
				"pattern": "Co-Authored-By"
			},
			{
				"text": "실제 커밋이 생성되지 않아야 함",
				"type": "no_file_changes"
			}
		]
	}
]
