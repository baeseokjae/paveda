{
	"name": "paveda",
	"version": "0.1.0",
	"description": "Portable agent harness — hook profiles, SQLite EventStore, PAL Router, SKILL.md loader",
	"type": "module",
	"packageManager": "pnpm@10.13.1",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"paveda": "dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"assets",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run --pool=forks --no-file-parallelism",
		"test:watch": "vitest",
		"lint": "biome check src tests scripts",
		"format": "biome format --write src tests scripts",
		"package:check": "node scripts/package-check.mjs",
		"performance:check": "node scripts/performance-check.mjs",
		"release:check": "pnpm typecheck && pnpm test && pnpm lint && pnpm build && pnpm performance:check && pnpm package:check",
		"release:tag": "git tag -a v0.1.0 -m v0.1.0 && git push origin v0.1.0",
		"release:github": "gh release create v0.1.0 --title v0.1.0 --notes-file docs/releases/v0.1.0.md",
		"prepack": "pnpm build"
	},
	"engines": {
		"node": ">=22"
	},
	"license": "MIT",
	"author": "Bae Seokjae",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/baeseokjae/paveda.git"
	},
	"keywords": [
		"agent-harness",
		"harness",
		"skill",
		"hook",
		"eventstore",
		"pal-router",
		"codex"
	],
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/node": "^22.0.0",
		"typescript": "^5.6.0",
		"vite": "^8.0.14",
		"vitest": "^4.1.7"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"yaml": "^2.9.0"
	}
}
